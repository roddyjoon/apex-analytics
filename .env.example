# =============================================================================
# APEX ANALYTICS — Environment Configuration
# Copy to .env and fill in your values. Never commit .env to git.
# =============================================================================

# ---------------- Database ----------------
# Local development (SQLite)
DATABASE_URL=sqlite:///./apex.db
# Production (Railway PostgreSQL)
# DATABASE_URL=postgresql://user:pass@host:5432/apex_analytics

# ---------------- Report Delivery ----------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
REPORT_EMAIL_TO=you@email.com
REPORT_EMAIL_FROM=apex@yourdomain.com

# Discord webhook (optional — quick summary card)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/xxxx

# ---------------- Error Monitoring ----------------
SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx

# ---------------- Static Site (Cloudflare Pages) ----------------
CLOUDFLARE_ACCOUNT_ID=xxxx
CLOUDFLARE_API_TOKEN=xxxx
CLOUDFLARE_PROJECT_NAME=apex-reports

# ---------------- Archive Storage (Backblaze B2) ----------------
B2_KEY_ID=xxxx
B2_APPLICATION_KEY=xxxx
B2_BUCKET_NAME=apex-reports

# ---------------- App Configuration ----------------
TIMEZONE=America/Los_Angeles
REPORT_MORNING_TIME=08:00
REPORT_PREGAME_TIME=13:00
REPORT_OUTPUT_DIR=./reports
LOG_LEVEL=INFO

# ---------------- Cache ----------------
CACHE_DIR=./cache
STATCAST_CACHE_TTL_HOURS=23
